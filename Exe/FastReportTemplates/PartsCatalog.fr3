      <TfrxMemoView Name="Categoriesvisual_tree" IndexTag="1" AllowVectorExport="True" Left="0" Top="0" Width="188,9765" Height="18,89765" StretchMode="smMaxHeight" DataField="visual_tree" DataSet="Categories" DataSetName="Categories" Font.Charset="1" Font.Color="-16777208" Font.Height="-13" Font.Name="Arial" Font.Style="1" Frame.Typ="0" ParentFont="False" Text="[Categories.&#34;visual_tree&#34;]"/>
