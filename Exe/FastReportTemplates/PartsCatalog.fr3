<?xml version="1.0" encoding="utf-8" standalone="no"?>
<TfrxReport Version="2023.2" DotMatrixReport="False" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="167935" PreviewOptions.Zoom="1" PrintOptions.Printer="Default" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="46236,0939160301" ReportOptions.Description.Text="" ReportOptions.LastChange="46237,6787442477" ScriptLanguage="PascalScript" ScriptText.Text="var&#13;&#10;  catID: integer;&#13;&#10;  GapStr: string;&#13;&#10;procedure MasterData1OnBeforePrint(Sender: TfrxComponent);&#13;&#10;var&#13;&#10;  i, level: integer;&#13;&#10;begin&#13;&#10;  catID := &#60;Categories.&#34;id&#34;&#62;;&#13;&#10;  Child1.Visible := Parts.Locate('category_id', catID, nil);&#13;&#10;  level := &#60;Categories.&#34;level&#34;&#62;;&#13;&#10;  GapStr := '';&#13;&#10;  for i := 0 to level - 1 do&#13;&#10;  begin&#13;&#10;    GapStr := GapStr + '    ';&#13;&#10;  end;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure MasterData2OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  TfrxBand(Sender).Visible := &#60;Parts.&#34;category_id&#34;&#62; = catID;&#13;&#10;end;&#13;&#10;&#13;&#10;begin&#13;&#10;&#13;&#10;end.">
  <Datasets>
    <item DataSet="Categories" DataSetName="Categories"/>
    <item DataSet="Parts" DataSetName="Parts"/>
  </Datasets>
  <TfrxDataPage Name="Data" HGuides.Text="" VGuides.Text="" Height="1000" Left="0" Top="0" Width="1000">
    <TfrxFDQuery Name="Categories" UserName="Categories" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" DataSetOptions="0" IgnoreDupParams="False" SQL.Text="WITH RECURSIVE category_tree AS (&#13;&#10;    -- 1. Базовый запрос: находим корневые элементы (у которых нет родителя)&#13;&#10;    SELECT &#13;&#10;        id, &#13;&#10;        parent_id, &#13;&#10;        name, &#13;&#10;        1 AS level, &#13;&#10;        name::text AS path&#13;&#10;    FROM categories&#13;&#10;    WHERE parent_id IS NULL&#13;&#10;&#13;&#10;    UNION ALL&#13;&#10;&#13;&#10;    -- 2. Рекурсивный запрос: находим дочерние элементы&#13;&#10;    SELECT &#13;&#10;        c.id, &#13;&#10;        c.parent_id, &#13;&#10;        c.name, &#13;&#10;        ct.level + 1, &#13;&#10;        ct.path || ' / ' || c.name&#13;&#10;    FROM categories c&#13;&#10;    INNER JOIN category_tree ct ON c.parent_id = ct.id&#13;&#10;)&#13;&#10;-- 3. Финальный вывод с форматированием&#13;&#10;SELECT &#13;&#10;    id,&#13;&#10;    parent_id,&#13;&#10;    level,&#13;&#10;    name,&#13;&#10;    path,&#13;&#10;    REPEAT('    ', level - 1) || name AS visual_tree&#13;&#10;FROM category_tree&#13;&#10;ORDER BY path;" MacroCreate="True" MacroExpand="True" ReadOnly="False" Left="60" Top="20">
      <Parameters>
        <item DataType="ftUnknown"/>
        <item DataType="ftUnknown"/>
      </Parameters>
    </TfrxFDQuery>
    <TfrxFDQuery Name="Parts" UserName="Parts" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" DataSetOptions="0" Master="Categories" IgnoreDupParams="False" SQL.Text="   SELECT &#13;&#10;       p.id AS part_id,&#13;&#10;       p.code,&#13;&#10;       p.category_id,&#13;&#10;       (&#13;&#10;           SELECT STRING_AGG(a.name || ': ' || &#13;&#10;                  COALESCE(pv.value_string, pv.value_number::text, pv.value_date::text, CASE WHEN pv.value_bool THEN 'Да' ELSE 'Нет' END), &#13;&#10;                  ', ')&#13;&#10;           FROM part_values pv&#13;&#10;           JOIN attribute_defs a ON a.id = pv.attribute_id&#13;&#10;           WHERE pv.part_id = p.id&#13;&#10;       ) AS attributes_str&#13;&#10;   FROM parts p&#13;&#10;   ORDER BY p.code" MacroCreate="True" MacroExpand="True" ReadOnly="False" MasterFields="category_id=id" Active="True" Left="124" Top="20"/>
  </TfrxDataPage>
  <TfrxReportPage Name="Page1" HGuides.Text="" VGuides.Text="" PaperWidth="210" PaperHeight="297" PaperSize="9" LeftMargin="10" RightMargin="10" TopMargin="10" BottomMargin="10" ColumnWidth="0" ColumnPositions.Text="" Frame.Typ="0" MirrorMode="0">
