    <TfrxMasterData Name="MasterData2" FillType="ftBrush" FillGap.Top="0" FillGap.Left="0" FillGap.Bottom="0" FillGap.Right="0" Frame.Typ="0" Height="18,89765" Left="0" Top="18,89765" Width="718,1107" OnBeforePrint="MasterData2OnBeforePrint" ColumnWidth="0" ColumnGap="0" DataSet="Parts" DataSetName="Parts" RowCount="0" Stretched="True">
      <TfrxMemoView Name="Memo1" IndexTag="1" AllowVectorExport="True" Left="0" Top="0" Width="188,9765" Height="18,89765" StretchMode="smMaxHeight" DataSet="Parts" DataSetName="Parts" Font.Charset="1" Font.Color="-16777208" Font.Height="-13" Font.Name="Arial" Font.Style="0" Frame.Typ="0" ParentFont="False" Text="[GapStr + &#60;Parts.&#34;code&#34;&#62;]"/>
      <TfrxMemoView Name="Memo2" IndexTag="1" AllowVectorExport="True" Left="188,9765" Top="0" Width="529,1342" Height="18,89765" StretchMode="smMaxHeight" DataSet="Parts" DataSetName="Parts" Font.Charset="1" Font.Color="-16777208" Font.Height="-13" Font.Name="Arial" Font.Style="0" Frame.Typ="0" ParentFont="False" Text="[GapStr + &#60;Parts.&#34;attributes_str&#34;&#62;]"/>
